{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "e2e": "bash scripts/e2e.sh",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:debug": "playwright test --debug",
        "e2e:report": "playwright show-report tests/e2e/report",
        "e2e:install": "playwright install chromium",
        "e2e:install:ci": "playwright install --with-deps chromium",
        "manual": "bash scripts/manual.sh",
        "manual:only": "playwright test --config=playwright.manual.config.ts",
        "manual:pdf": "node scripts/manual-pdf.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "axios": "^1.21.1",
        "concurrently": "^10.0.7",
        "laravel-vite-plugin": "^3.2.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.3.8"
    },
    "dependencies": {
        "@laravel/passkeys": "^0.4.1"
    }
}
