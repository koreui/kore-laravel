<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>app/Modules/*/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Modules/*/Database/Migrations</directory>
        </exclude>
    </source>
    <php>
        <!--
            force="true": sin él, PHPUnit respeta una variable ya presente en el entorno.
            Cuando Pest se lanza desde un proceso que ya cargó .env (los hooks de git,
            un `artisan` que invoca Pest), heredaría APP_ENV=local y el .env del
            desarrollador. Con force, la suite corre siempre en su entorno.
        -->
        <!-- PulseAccessTest renderiza el bundle JS de Pulse; con el memory_limit de 128M de algunos PHP la suite revienta. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <!--
            Clave fija y desechable para la suite: sólo firma sesiones y cookies de
            test. Sin ella, en CI (donde no hay .env) toda petición web muere con
            MissingAppKeyException; con ella, la suite no depende de la APP_KEY del
            desarrollador ni de copiar .env.example.
        -->
        <env name="APP_KEY" value="base64:zz0tTHUiTwWvBGr0R228Velea3LYg6PiPFW/ndcJVbc=" force="true"/>
        <env name="APP_LOCALE" value="es" force="true"/>
        <env name="APP_FALLBACK_LOCALE" value="en" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!--
            El visor de /docs va apagado por defecto en la suite: .env.example lo
            trae en true (es cómodo en local) y sin este force el desarrollador
            que copia .env.example vería fallar los tests que comprueban el caso
            "toggle apagado". Los que necesitan el visor lo encienden con el
            helper withEnvironment() de tests/Pest.php.
        -->
        <env name="DOCS_ENABLED" value="false" force="true"/>
        <!--
            La documentación OpenAPI va apagada por defecto, por lo mismo que el
            visor de /docs: .env.example invita a encenderla en local y sin este
            force los tests que comprueban el caso "toggle apagado" fallarían
            sólo en la máquina de quien la tiene puesta. ApiDocsTest la enciende
            con withEnvironment() (tests/Pest.php).
        -->
        <env name="API_DOCS" value="false" force="true"/>
        <!--
            El harness E2E va apagado por defecto en la suite, por lo mismo que
            el visor de docs: si el desarrollador tuviera E2E_HARNESS=true en su
            .env, los tests del caso "toggle apagado" fallarían sólo en su
            máquina. Los que necesitan las rutas /__e2e__/* lo encienden con
            withEnvironment() (tests/Pest.php).
        -->
        <env name="E2E_HARNESS" value="false" force="true"/>
        <!--
            El módulo Pdf va apagado por defecto en la suite, por lo mismo que
            los tres de arriba: si el desarrollador tuviera PDF_ENABLED=true en
            su .env, los tests del caso "toggle apagado" fallarían sólo en su
            máquina. Los que necesitan el módulo lo encienden con
            withEnvironment() (tests/Pest.php), y ninguno habla con Gotenberg:
            la conversión la intercepta `Pdf::fake()`.
        -->
        <env name="PDF_ENABLED" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
