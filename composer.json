{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kore/kore-laravel",
    "type": "project",
    "description": "Production-ready Laravel 13 boilerplate with Livewire 4, Tailwind v4, koreUi and AI-friendly tooling.",
    "keywords": [
        "laravel",
        "livewire",
        "tailwind",
        "kore-ui",
        "boilerplate"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13",
        "gotenberg/gotenberg-php": "^2.25",
        "kore-ui/kore-ui": "^2.3.1",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.0",
        "laravel/pennant": "^1.23",
        "laravel/pulse": "^1.7",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/livewire": "^4.0",
        "sentry/sentry-laravel": "^4.25",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-data": "^4.22",
        "spatie/laravel-health": "^1.39",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-one-time-passwords": "^1.1",
        "spatie/laravel-pdf": "^2.13",
        "spatie/laravel-permission": "^8.0",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3",
        "fakerphp/faker": "^1.23",
        "igorsgm/laravel-git-hooks": "^2.1",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpat/phpat": "^0.12",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.4",
        "spaze/phpstan-disallowed-calls": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "test:parallel": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --parallel"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --coverage --min=80"
        ],
        "e2e": [
            "npm run e2e"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:test": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "arch": [
            "@php artisan kore:arch:check"
        ],
        "refactor": [
            "@php vendor/bin/rector process"
        ],
        "refactor:test": [
            "@php vendor/bin/rector process --dry-run"
        ],
        "ci": [
            "@lint:test",
            "@analyse",
            "@arch",
            "@refactor:test",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan git-hooks:register --ansi || true"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "spatie/laravel-backup",
                "stancl/tenancy"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
