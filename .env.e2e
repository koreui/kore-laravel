#---------------------------------------------------------------
# kore-laravel — entorno E2E (Playwright)
#---------------------------------------------------------------
# Este archivo SÍ se commitea: no contiene secretos reales. La APP_KEY
# es desechable y sólo sirve para firmar sesiones de la suite E2E.
#
# Laravel carga este archivo automáticamente cuando arranca con la
# variable de entorno APP_ENV=e2e:
#
#   APP_ENV=e2e php artisan migrate:fresh --seed --seeder=Database\\Seeders\\E2eSeeder
#   APP_ENV=e2e php artisan serve --host=127.0.0.1 --port=8010
#
# `php artisan serve` propaga APP_ENV al proceso hijo (está en
# ServeCommand::$passthroughVariables), así que el servidor embebido
# también lee este archivo.
#---------------------------------------------------------------

APP_NAME="kore-laravel"
APP_ENV=e2e
APP_KEY=base64:qmRo8CmcTXrEYnmutqz7UfgYNGN64J+aJkEi1KQsaNA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Hash barato: la suite crea usuarios y hace login por la UI real.
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite dedicado. La ruta es relativa: SQLiteConnector la resuelve con
# base_path() cuando realpath() del relativo falla. globalSetup la crea
# y la migra desde cero en cada corrida.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

# Sesión en DB para que storageState sobreviva entre workers de Playwright.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log: el mail se escribe en storage/logs/laravel.log. Es lo que permite
# leer el código OTP del magic link desde la suite.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#---------------------------------------------------------------
# Toggles del boilerplate (config/kore-app.php) — defaults
#---------------------------------------------------------------

API_ENABLED=true

TENANCY_ENABLED=false
TENANCY_MODE=single-db

REVERB_ENABLED=false

OCTANE_ENABLED=false
OCTANE_SERVER=frankenphp

SCOUT_ENABLED=false
SCOUT_DRIVER=meilisearch

AUTH_2FA_ENABLED=true
AUTH_MAGIC_LINKS=true
AUTH_SOCIAL_LOGIN=false
SOCIAL_GOOGLE=false
SOCIAL_GITHUB=false

# Observabilidad apagada: la suite no debe hablar con servicios externos.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_ENABLED=false
PULSE_ENABLED=false

HEALTH_SECRET_TOKEN=
