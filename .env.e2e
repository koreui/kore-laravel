#---------------------------------------------------------------
# kore-laravel — entorno E2E (Playwright)
#---------------------------------------------------------------
# Este archivo SÍ se commitea: no contiene secretos reales. La APP_KEY
# es desechable y sólo sirve para firmar sesiones de la suite E2E.
#
# Laravel carga este archivo automáticamente cuando arranca con la
# variable de entorno APP_ENV=e2e:
#
#   APP_ENV=e2e php artisan migrate:fresh --seed --seeder=Database\\Seeders\\E2eSeeder
#   APP_ENV=e2e php artisan serve --host=localhost --port=8010
#
# `php artisan serve` propaga APP_ENV al proceso hijo (está en
# ServeCommand::$passthroughVariables), así que el servidor embebido
# también lee este archivo.
#---------------------------------------------------------------

APP_NAME="kore-laravel"
APP_ENV=e2e
APP_KEY=base64:qmRo8CmcTXrEYnmutqz7UfgYNGN64J+aJkEi1KQsaNA=
APP_DEBUG=true
# `localhost` y no `127.0.0.1`: WebAuthn exige que el «relying party id» sea un
# dominio, y Chrome rechaza los literales IP («The relying party ID is not a
# registrable domain suffix of, nor equal to the current domain»). Con `localhost`
# el navegador además trata el origen http como seguro, así que la suite puede
# ejercitar passkeys sin TLS. El host y el puerto del webServer salen de aquí
# (`tests/e2e/support/env.ts`).
APP_URL=http://localhost:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Hash barato: la suite crea usuarios y hace login por la UI real.
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite dedicado. La ruta es relativa: SQLiteConnector la resuelve con
# base_path() cuando realpath() del relativo falla. globalSetup la crea
# y la migra desde cero en cada corrida.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

# Sesión en DB para que storageState sobreviva entre workers de Playwright.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log: el mail se escribe entero en un canal de log. MAIL_LOG_CHANNEL lo manda
# a `e2e_mail` (config/logging.php → storage/logs/e2e-mail.log) en vez de a
# laravel.log, para que la suite lea el enlace de reset o el código OTP sin
# rascar entre el ruido de la aplicación. Lo sirve `GET /__e2e__/mail/last`.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=e2e_mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#---------------------------------------------------------------
# Toggles del boilerplate (config/kore-app.php) — defaults
#---------------------------------------------------------------

API_ENABLED=true

TENANCY_ENABLED=false

AUTH_2FA_ENABLED=true
AUTH_MAGIC_LINKS=true
AUTH_SOCIAL_LOGIN=false
SOCIAL_GOOGLE=false
SOCIAL_GITHUB=false

# Encendido: la suite registra y usa una passkey con el autenticador virtual
# de CDP (specs/auth/passkeys.spec.ts).
AUTH_PASSKEYS=true

# Encendido: la suite comprueba el visor de docs/ en /docs.
DOCS_ENABLED=true

# APAGADO a propósito, y es la única entrada del mapa de acceso que espera 404
# para los cinco perfiles. Encenderlo haría que `/pdf/preview/download` fuera un
# 200 para el superadmin, y ese 200 sólo existe con un Gotenberg levantado: en
# CI no lo hay, así que la suite entera dependería de un servicio externo por
# una pantalla de maquetación. Lo que sí queda probado en el navegador es el
# contrato del toggle apagado — que la ruta no existe. La pantalla y el PDF los
# cubren los tests de Pest del módulo, con `Pdf::fake()`.
PDF_ENABLED=false

# Harness de la suite: rutas /__e2e__/*. Éste es el ÚNICO archivo del
# repositorio que lo enciende, y aun así hacen falta los otros dos candados de
# HarnessGuard: el entorno (`e2e`) y una base de pruebas (`database/e2e.sqlite`).
E2E_HARNESS=true

# Observabilidad apagada: la suite no debe hablar con servicios externos.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
PULSE_ENABLED=false

HEALTH_SECRET_TOKEN=
