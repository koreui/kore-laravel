APP_NAME="kore-laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En producción, para enviar también los logs a Sentry: LOG_STACK=single,sentry
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Nivel mínimo del canal `sentry` (config/logging.php)
LOG_SENTRY_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#---------------------------------------------------------------
# kore-laravel — feature toggles (config/kore-app.php)
#---------------------------------------------------------------

# Aquí sólo hay toggles que el código lee de verdad.
# Reverb (websockets), Octane/FrankenPHP y Scout+Meilisearch NO son toggles:
# son módulos opcionales que se instalan bajo demanda (`composer require ...`)
# y traen su propia config. Un toggle para un paquete que no está instalado
# sólo sirve para mentir sobre lo que el boilerplate hace.

# API (Sanctum + rutas API). true | false
API_ENABLED=true

# Multi-tenancy (stancl/tenancy). true | false
# El modo single-db / multi-db NO se decide por .env: se elige al ejecutar
# `php artisan kore:tenancy:enable` y queda en la config de stancl/tenancy.
TENANCY_ENABLED=false

# Auth
AUTH_2FA_ENABLED=true
AUTH_MAGIC_LINKS=true
AUTH_SOCIAL_LOGIN=false
SOCIAL_GOOGLE=false
SOCIAL_GITHUB=false

# Observabilidad
# Sentry: si SENTRY_LARAVEL_DSN está vacío, el SDK no envía nada
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Pulse: panel /pulse (sólo rol superadmin, gate `viewPulse`)
PULSE_ENABLED=false

# Spatie Health
#   /health       → HTML, requiere sesión + rol superadmin (gate `viewHealth`)
#   /health/json  → JSON, requiere el header `X-Secret-Token` con este valor.
#                   OJO: si lo dejas vacío el endpoint queda ABIERTO.
HEALTH_SECRET_TOKEN=
