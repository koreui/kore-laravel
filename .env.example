APP_NAME="kore-laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Nivel mínimo del canal `sentry` (config/logging.php)
LOG_SENTRY_LEVEL=error
# Formatter del canal `stderr`. Ausente o vacío = LineFormatter (texto plano).
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

#---------------------------------------------------------------
# Logging en producción (Docker)
#---------------------------------------------------------------
#
# En un contenedor los logs NO van a un archivo: van a stderr y los recoge el
# runtime. Un `single` dentro del contenedor escribe en storage/logs/laravel.log,
# que vive en la capa efímera de la imagen —se pierde en cada deploy— y que
# ningún `docker compose logs` muestra.
#
# La receta de producción son estas cuatro líneas:
#
#   LOG_CHANNEL=stack
#   LOG_STACK=stderr                                  # o `stderr,sentry`
#   LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
#   LOG_LEVEL=warning
#
# - LOG_STACK=stderr        el stack pasa a tener un solo canal: el de stderr.
#                           Con `stderr,sentry` los errores van además a Sentry
#                           a partir de LOG_SENTRY_LEVEL.
# - LOG_STDERR_FORMATTER    nombre de clase de un formatter de Monolog. Con
#                           JsonFormatter cada línea es un objeto JSON y
#                           cualquier agregador (Loki, Datadog, `jq`) la parsea
#                           sin regex. Si la variable queda vacía, Laravel deja
#                           el LineFormatter y salen líneas de texto: no falla,
#                           simplemente no es JSON.
# - LOG_LEVEL=warning       `debug` en producción llena el disco del VPS con la
#                           rotación de Docker (10 MB × 5 por contenedor).
#
# La rotación la pone el `logging: *default-logging` de docker-compose.prod.yml
# (json-file, max-size 10m, max-file 5). Ver docs/ops/deployment.md § Logs.
# `tests/Feature/LoggingTest.php` blinda que estas variables construyan de
# verdad el logger esperado.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#---------------------------------------------------------------
# kore-laravel — feature toggles (config/kore-app.php)
#---------------------------------------------------------------

# Aquí sólo hay toggles que el código lee de verdad.
# Reverb (websockets), Octane/FrankenPHP y Scout+Meilisearch NO son toggles:
# son módulos opcionales que se instalan bajo demanda (`composer require ...`)
# y traen su propia config. Un toggle para un paquete que no está instalado
# sólo sirve para mentir sobre lo que el boilerplate hace.

# API (Sanctum + rutas API). true | false
API_ENABLED=true

# Documentación OpenAPI de la API (dedoc/scramble) en /api/docs y /api/docs.json.
# Vive en config/kore-api.php, no en kore-app: no es un toggle del boilerplate
# sino un parámetro del contrato de la API. En local ponlo en true; en
# producción déjalo en false salvo que quieras publicarla — y aun encendida
# sigue detrás del gate `viewApiDocs` (sólo superadmin fuera de local).
API_DOCS=false

# Caducidad de los tokens que emite POST /api/v1/auth/login, en minutos.
# 43200 = 30 días. `null` = sin caducidad. Se aplica token a token al emitirlo,
# NO por `sanctum.expiration` (que es global y retroactiva). Vive en
# config/kore-api.php.
API_TOKEN_EXPIRES_MINUTES=43200

# Multi-tenancy (stancl/tenancy). true | false
# El modo single-db / multi-db NO se decide por .env: se elige al ejecutar
# `php artisan kore:tenancy:enable` y queda en la config de stancl/tenancy.
TENANCY_ENABLED=false

# Auth
AUTH_2FA_ENABLED=true
AUTH_MAGIC_LINKS=true
AUTH_SOCIAL_LOGIN=false
SOCIAL_GOOGLE=false
SOCIAL_GITHUB=false

# Passkeys (WebAuthn) vía Fortify: botón «Entrar con passkey» en /login y
# pantalla /user/passkeys. Encendido por defecto — mientras nadie registre una
# no cambia nada, y el día que alguien la registre ya está.
#
# ⚠️ El «relying party id» sale de APP_URL (`config/fortify.php` → passkeys):
# es el DOMINIO al que quedan atadas las credenciales. Cambiar de dominio
# invalida todas las passkeys registradas, y en producción APP_URL tiene que
# ser el dominio real y con https (WebAuthn sólo admite http en localhost).
AUTH_PASSKEYS=true
# Opcional, y sólo si algún día vas a rotar APP_KEY: el user handle de WebAuthn
# se deriva de la clave de la aplicación. Fija este secreto ANTES de rotar y las
# passkeys sobreviven; rota sin fijarlo y quedan todas invalidadas. Déjala
# comentada, nunca presente y vacía.
# PASSKEYS_USER_HANDLE_SECRET=

# Registro por invitación + estado de alta de la cuenta. Opt-in: por defecto el
# registro está abierto, que es lo que espera un proyecto nuevo. Encendido,
# /register exige un código, la cuenta nace con el rol que dice ese código, y
# quien entre por una puerta sin código (login social) queda `pending` hasta que
# alguien la active desde /users/{id}/edit. Añade la pantalla /invitations
# (permiso `invitations.manage`), la de espera /account/pending y el comando
# `invitations:prune` en el scheduler.
#
# Las TABLAS se migran igual con el toggle apagado —`invitation_codes` y las
# columnas `account_status` / `activated_at` de `users`—: un toggle apaga rutas
# y comportamiento, nunca el esquema. Ver docs/modules/auth.md.
AUTH_INVITATIONS=false

# Harness de la suite E2E: rutas /__e2e__/* que crean usuarios, entran como un
# rol y leen el buzón de correo sin pasar por la UI. Lo enciende `.env.e2e` y
# nadie más; aquí va en false y en producción no se toca.
E2E_HARNESS=false

# Inventario de dispositivos que consumen la API (módulo Devices): rutas
# /api/v1/devices, listeners de los eventos de token de Auth y el comando
# `devices:cleanup` en el scheduler. Opt-in: un proyecto sin app móvil ni CLI no
# lo necesita. La TABLA `devices` se migra igual con el toggle apagado — un
# toggle apaga rutas y comportamiento, nunca el esquema.
DEVICES_ENABLED=false

# Versión mínima de cliente que acepta el middleware `devices.version`
# (cabecera X-App-Version). Es opt-in por ruta, así que subirla sólo corta los
# endpoints que lo declaran. El resto de parámetros del módulo —retención y
# plataformas— viven en config/devices.php, que no son booleanos.
# DEVICES_MIN_APP_VERSION=0.0.0

# Generación de PDF (módulo Pdf: spatie/laravel-pdf con Gotenberg detrás).
# Enciende las rutas /pdf/preview (gate `viewPdfPreview`: superadmin y
# administrador) y el binding de App\Core\Contracts\PdfRenderer. Opt-in porque
# el motor es un SERVICIO aparte: sin Gotenberg levantado no hay PDF.
#
#   local:      docker run --rm -p 127.0.0.1:3000:3000 gotenberg/gotenberg:8
#   producción: docker compose --profile pdf up -d  (docker-compose.prod.yml)
#
# Ver docs/modules/pdf.md.
PDF_ENABLED=false

# Dónde escucha Gotenberg. En local, el contenedor suelto de arriba; en
# producción, el servicio del perfil `pdf`, que NO publica puerto y se alcanza
# por la red interna de compose: GOTENBERG_URL=http://gotenberg:3000
# GOTENBERG_URL=http://127.0.0.1:3000

# Otro motor de spatie/laravel-pdf (dompdf, browsershot, chrome...). Cambiarlo
# exige instalar su paquete; el boilerplate viene con gotenberg.
# LARAVEL_PDF_DRIVER=gotenberg

# Marca de los documentos (config/kore-pdf.php). Las rutas son RELATIVAS a
# public/, y la imagen se imprime embebida como data: URI — nunca enlazada, o
# Gotenberg la pediría a sí mismo y saldría rota en silencio.
# PDF_LOGO=img/logo.png
# PDF_SECONDARY_LOGO=img/logo-cliente.png
# PDF_FORMAT=a4
#
# Texto de la marca de agua. Estar configurada no la pone: se PIDE al generar
# el documento, porque el mismo reporte se entrega limpio y circula sellado.
# PDF_WATERMARK=COPIA NO CONTROLADA

# Almacenamiento de archivos con versionado por slot (módulo Files, sobre
# spatie/laravel-medialibrary): el contrato `FileStore`, la ruta firmada
# /files/{file} y el comando `files:cleanup`. Opt-in: un proyecto que no sube
# ficheros no lo necesita. La TABLA `media` se migra igual con el toggle apagado
# — un toggle apaga rutas y comportamiento, nunca el esquema.
FILES_ENABLED=false

# Discos del módulo Files. `local` = storage/app/private (privado, sólo por URL
# firmada); `public` = storage/app/public, servible por /storage tras
# `php artisan storage:link`. Con un disco remoto en FILES_DISK, enciende
# FILES_SYNC para que la subida no bloquee la petición.
# FILES_DISK=local
# FILES_PUBLIC_DISK=public
# FILES_STAGING_DISK=local

# Comprimir cada archivo en cola después de guardarlo. Apagado por defecto
# porque tiene requisitos fuera de PHP: Ghostscript para los PDF y un driver de
# imagen para las fotos. Sin él, todo archivo se queda en `pending`.
# FILES_COMPRESSION=false

# Mover el archivo del disco de staging al de destino en cola. Se enciende
# cuando FILES_DISK es remoto (S3/R2). El resto de parámetros —TTL de la URL
# firmada, calidad de imagen, límite de subida— viven en config/files.php.
# FILES_SYNC=false

# Visor de docs/ en /docs: sirve los Markdown del repo con la UI de la app.
# En local sí (es la forma cómoda de leer las reglas sin salir del proyecto);
# en producción NO, porque publica la documentación interna a cualquiera.
DOCS_ENABLED=true

# Observabilidad
# Sentry: si SENTRY_LARAVEL_DSN está vacío, el SDK no envía nada
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Pulse: panel /pulse (sólo rol superadmin, gate `viewPulse`)
PULSE_ENABLED=false

# Spatie Health
#   /health       → HTML, requiere sesión + rol superadmin (gate `viewHealth`)
#   /health/json  → JSON, requiere el header `X-Secret-Token` con este valor.
#                   OJO: si lo dejas vacío el endpoint queda ABIERTO.
HEALTH_SECRET_TOKEN=

# Cabeceras de seguridad (config/security.php)
# Las emite la APLICACIÓN (App\Http\Middleware\SecurityHeaders) en el grupo `web`,
# no el servidor: así funcionan igual en Docker, en Forge, en Laravel Cloud o en
# un `artisan serve`. Las cabeceras fijas —X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy, Permissions-Policy, Cross-Origin-Opener-Policy— no llevan
# variable: se cambian en config/security.php, que es donde se revisan.

# HSTS. Sólo se emite sobre HTTPS: en HTTP el navegador la ignora por spec.
# Ponlo en false si terminas el TLS en un CDN que ya la envía por su cuenta.
SECURITY_HSTS=true

# Content Security Policy. true | false
CSP_ENABLED=true

# true  → Content-Security-Policy-Report-Only (el navegador informa, no bloquea)
# false → Content-Security-Policy (bloquea)
# Se estrena SIEMPRE en true: se despliega, se leen los informes unos días y sólo
# cuando estén limpios se pasa a false. Ver docs/ops/deployment.md.
CSP_REPORT_ONLY=true

# Endpoint que recibe los informes de violación. Vacío = sin report-uri, y
# entonces report-only no sirve de nada porque nadie ve lo que se bloquearía.
# Sentry lo ofrece en Settings → Security Headers de cada proyecto.
CSP_REPORT_URI=

# Backups (spatie/laravel-backup)
# Con BACKUP_ENABLED=false el provider del paquete no se registra: no hay
# comandos backup:*, ni check de salud, ni nada programado en el scheduler.
BACKUP_ENABLED=false

# Discos de destino, separados por comas. Los mismos que vigila el monitor.
# `local` = storage/app/private/<BACKUP_NAME>/ (el volumen storage_data en Docker).
# Para S3 hace falta `composer require league/flysystem-aws-s3-v3`; deja `local`
# el primero, que es el disco que abre el check de /health al arrancar.
BACKUP_DISKS=local

# Contraseña del zip (AES-256). VACÍA = backup SIN cifrar.
# En producción es obligatoria: `openssl rand -base64 32`. Guárdala fuera del
# servidor — si la pierdes, los backups son irrecuperables.
BACKUP_ARCHIVE_PASSWORD=

# Destinatario de los avisos de backup:run / backup:clean / backup:monitor.
# Si se deja vacío usa MAIL_FROM_ADDRESS.
# BACKUP_NOTIFICATION_MAIL=ops@tu-dominio.com

# Opcional. Carpeta dentro de cada disco y nombre que usa el monitor.
# Por defecto, APP_NAME.
# BACKUP_NAME=kore-laravel

# Opcional. Días máximos sin backup nuevo antes de que backup:monitor lo declare
# no sano. Por defecto 1, que es la cadencia del scheduler.
# BACKUP_MAX_AGE_DAYS=1

# Opcional. Bandera extra para mariadb-dump (config/database.php → mysql.dump).
# La red interna de docker-compose.prod.yml va sin TLS y el cliente mariadb 11.x
# lo exige por defecto. Déjalo vacío si tu MySQL sí habla TLS.
# BACKUP_DUMP_EXTRA_OPTION=--skip-ssl
