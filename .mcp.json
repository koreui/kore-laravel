{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "kore": {
            "command": "php",
            "args": [
                "artisan",
                "mcp:start",
                "kore"
            ]
        },
        "kore-ui": {
            "type": "http",
            "url": "https://kore-ui-mcp.ovilla.dev/mcp"
        }
    }
}
